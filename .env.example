# Local server defaults
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
TRUST_PROXY=false
SECURE_COOKIES=false
APP_BASE_URL=http://127.0.0.1:4173

# Local SQLite is used while both Turso values are blank.
STRATA_DATA_DIR=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Account email stays disabled until every required provider value is set.
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_VERIFICATION_SECRET=
ADMIN_EMAIL=
# Production always requires the registered-email security code after the owner password.
# Set true only to exercise the same two-step flow in development or tests.
ADMIN_EMAIL_MFA_REQUIRED=false
SUPPORT_EMAIL=

# Checkout stays disabled until all Paddle credentials are configured.
# Sandbox requires an isolated nonproduction instance, separate DB and sandbox catalog.
# See docs/deployment.md before changing this setting.
PADDLE_ENVIRONMENT=live
PADDLE_CHECKOUT_ENABLED=false
# Required: the product that owns the recurring $2.99 USD monthly Paddle price.
PADDLE_PRODUCT_ID=
# Required: the recurring $2.99 USD monthly Paddle price ID. Do not reuse the retired one-time price ID.
PADDLE_PRICE_ID=
# Optional: comma-separated earlier recurring price IDs on the same product.
# These preserve existing subscriptions only; new checkout always uses PADDLE_PRICE_ID.
PADDLE_LEGACY_RECURRING_PRICE_IDS=
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENFORCE_IP_ALLOWLIST=false

# Strata AI stays switched off until AI_BASE_URL and AI_MODEL are set.
# Any OpenAI-compatible server works (for example Atomic Chat, llama.cpp, or LM Studio).
# Use an https:// address in production; plain http is only accepted for this machine.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional tuning. Defaults: 120000 ms timeout, 3 requests at once, 20 waiting, 30 per member per UTC day.
AI_TIMEOUT_MS=
AI_MAX_CONCURRENT=
AI_MAX_QUEUE=
AI_DAILY_LIMIT=
# Optional Cloudflare Access service token, if the model endpoint sits behind Cloudflare Access.
AI_ACCESS_CLIENT_ID=
AI_ACCESS_CLIENT_SECRET=
