# Local server defaults
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
TRUST_PROXY=false
SECURE_COOKIES=false
APP_BASE_URL=http://127.0.0.1:4173

# Local SQLite is used while both Turso values are blank.
STRATA_DATA_DIR=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Account email stays disabled until every required provider value is set.
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_VERIFICATION_SECRET=
ADMIN_EMAIL=
SUPPORT_EMAIL=

# Checkout stays disabled until all Paddle credentials are configured.
# Sandbox requires an isolated nonproduction instance, separate DB and sandbox catalog.
# See docs/deployment.md before changing this setting.
PADDLE_ENVIRONMENT=live
PADDLE_CHECKOUT_ENABLED=false
# Required: the product that owns the recurring $2.99 USD monthly Paddle price.
PADDLE_PRODUCT_ID=
# Required: the recurring $2.99 USD monthly Paddle price ID. Do not reuse the retired one-time price ID.
PADDLE_PRICE_ID=
# Optional: comma-separated earlier recurring price IDs on the same product.
# These preserve existing subscriptions only; new checkout always uses PADDLE_PRICE_ID.
PADDLE_LEGACY_RECURRING_PRICE_IDS=
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENFORCE_IP_ALLOWLIST=false

# Strata+ bought in the STRATA iOS app through Apple In-App Purchase (see docs/apple-in-app-purchase.md).
# Both default to the App Store Connect setup, so production needs neither unless the app or product changes.
# Signed purchases are verified against the pinned Apple Root CA - G3; there is no Apple secret to configure.
APPLE_BUNDLE_ID=online.stratafitness.app
# Comma-separated auto-renewable Strata+ product IDs the server accepts.
APPLE_IAP_PRODUCT_IDS=online.stratafitness.app.plus.monthly

# Strata AI runs on Groq (OpenAI-compatible) and stays switched off until GROQ_API_KEY and STRATA_AI_MODEL are set.
# Models are never hard-coded: confirm both IDs are active production models in GET /openai/v1/models first.
# In the Groq console, turn on Zero Data Retention under Data Controls before members use it.
GROQ_API_KEY=
STRATA_AI_MODEL=openai/gpt-oss-120b
STRATA_AI_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional: another OpenAI-compatible provider (https only in production).
STRATA_AI_BASE_URL=
# Optional budget. Defaults: 900 requests per UTC day for the whole organization, 25 per minute,
# 40% of the day reserved for Daily Briefs, 30 chat requests per member per day.
# Moving to a paid Groq tier is a config change: raise these numbers.
STRATA_AI_DAILY_REQUESTS=
STRATA_AI_REQUESTS_PER_MINUTE=
STRATA_AI_BRIEF_SHARE=
STRATA_AI_USER_DAILY_LIMIT=
# Optional: Daily Brief on/off (default on) and the member's local hour it starts (default 5).
STRATA_AI_DAILY_BRIEF=
STRATA_AI_BRIEF_HOUR=
# Optional tuning. Defaults: 60000 ms timeout, 3 requests at once, 20 waiting.
STRATA_AI_TIMEOUT_MS=
STRATA_AI_MAX_CONCURRENT=
STRATA_AI_MAX_QUEUE=

# Polar AccessLink V4 connected devices (Strata+) stay off until POLAR_CLIENT_ID,
# POLAR_CLIENT_SECRET, and DEVICE_TOKEN_KEY are set. The server requests only
# sleep:read, nightly_recharge:read, continuous_samples:read, and training_sessions:read.
# Register the V4 app at https://admin.polaraccesslink.com with the redirect URL
# https://<your domain>/api/devices/polar/callback (APP_BASE_URL is used to build it).
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# Optional: only when the redirect URL differs from APP_BASE_URL + /api/devices/polar/callback.
POLAR_REDIRECT_URI=
# V4 is polling-only in STRATA; there is no Polar webhook secret or webhook setup command.
# 32 random bytes as base64 encrypt each member's versioned access-token + rotating-refresh-token
# envelope (including expiry and granted scopes) at rest. Create one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# To rotate, move the old value to DEVICE_TOKEN_KEY_PREVIOUS and set a new DEVICE_TOKEN_KEY.
# Disconnect/account deletion removes credentials and imported data locally. Members remove the
# Polar-side consent separately at https://account.polar.com/ when they want to withdraw it remotely.
DEVICE_TOKEN_KEY=
DEVICE_TOKEN_KEY_PREVIOUS=
# Optional: how often, in milliseconds, the sync loop looks for connections that are due (default 60000).
DEVICE_SYNC_INTERVAL_MS=
