{
  "name": "strata-workout-index",
  "version": "8.5.0",
  "private": true,
  "description": "Evidence-informed exercise rankings with Strata+ personalization, session building, community weekly plans, ratings, and 31-day planning.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node scripts/dev.js",
    "test": "node --test",
    "test:unit": "node scripts/run-test-layer.js unit",
    "test:integration": "node scripts/run-test-layer.js integration",
    "test:contract": "node scripts/run-test-layer.js contract",
    "test:e2e": "node scripts/run-test-layer.js e2e",
    "test:visual": "node --test qa/e2e/responsive-content.js qa/e2e/navigation-layout.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.boundaries.json",
    "architecture:check": "node scripts/architecture-report.js && node scripts/frontend-architecture-report.js",
    "coverage": "node scripts/coverage-check.js",
    "performance": "node scripts/performance-check.js",
    "preflight:production": "node --env-file-if-exists=.env scripts/config-preflight.js --require-all",
    "smoke:deploy": "node scripts/deploy-smoke.js --require-all",
    "check": "npm run release:check && npm run architecture:check && npm run typecheck && npm run lint && npm run coverage && npm run qa:runtime && npm run performance && npm run test:e2e",
    "qa": "npm run check",
    "qa:runtime": "node qa/account-runtime-smoke.js && node qa/discover-runtime-smoke.js && node qa/planner-runtime-smoke.js && node qa/workout-runtime-smoke.js && node qa/pwa-runtime-smoke.js",
    "qa:ui": "node qa/ui-audit.js",
    "release:check": "node scripts/release-version.js --check",
    "release:version": "node scripts/release-version.js",
    "load:100": "node scripts/load-100-users.js --json",
    "load:100:shared": "node scripts/load-100-users.js --json --shared-ip"
  },
  "dependencies": {
    "@tursodatabase/serverless": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "espree": "11.2.0",
    "globals": "17.12.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
