{
  "appId": "online.stratafitness.app",
  "appName": "STRATA",
  "webDir": "www",
  "loggingBehavior": "debug",
  "backgroundColor": "#10110f",
  "appendUserAgent": "StrataApp/1",
  "server": {
    "url": "https://stratafitness.online",
    "errorPath": "offline.html",
    "allowNavigation": ["auth.polar.com"]
  },
  "ios": {
    "scheme": "App",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true,
    "preferredContentMode": "mobile",
    "webContentsDebuggingEnabled": false
  }
}
